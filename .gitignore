# Built artifacts — regenerated by tools/build.js, published as releases.
packs/
reports/

# The private jars are published as immutable GitHub release assets and
# referenced by URL in the manifest. Keeping 22 MB of jars in git would bloat
# every clone and CI checkout for no benefit.
external-mods/

# A live server install: mods, libraries, and a multi-hundred-MB world.
server/

node_modules/
*.log

# Modrinth API response cache — regenerated on demand, 11 MB of churn.
.cache/
