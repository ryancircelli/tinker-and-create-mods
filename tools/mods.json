{
  "pack": {
    "name": "Tinker & Create",
    "summary": "Create + Tinkers for Minecraft 1.21.1 NeoForge",
    "version": "1.8.5",
    "minecraft": "1.21.1",
    "loader": "neoforge",
    "loaders": [
      "neoforge"
    ],
    "loaderVersion": "21.1.248"
  },
  "//tinkers": "Tinkers' Construct 3.12.2 and Mantle 1.12.1 for 1.21.1 are shipped via overrides/mods/ because neither the port nor Mantle exists on Modrinth for 1.21.1 — a .mrpack can only reference cdn.modrinth.com URLs. Source: zhuchuovo/TinkersConstruct-1.21.1 and zhuchuovo/Mantle-1.21.1, forked to ryancircelli/. Verified booting with Create via tools/isolate.js --jar.",
  "//loader": "1.21.1 NeoForge has 809 Create modpacks; 1.21.1 Forge has ZERO. NeoForge is the only viable 1.21 target.",
  "aliases": {},
  "exclusiveGroups": [
    {
      "label": "Recipe viewer",
      "members": [
        "emi",
        "jei",
        "roughly-enough-items"
      ],
      "keep": "emi",
      "reason": "Two recipe viewers double up keybinds, overlays and memory. The pack is built on EMI (EMI Loot/Ores/Trades/Enchanting all target it)."
    },
    {
      "label": "Death grave handler",
      "members": [
        "forgotten-graves",
        "gravestones",
        "coffins",
        "yigd"
      ],
      "keep": "forgotten-graves",
      "reason": "Multiple grave mods race to capture the death drop event; the loser silently voids inventories."
    },
    {
      "label": "Rendering engine",
      "members": [
        "sodium",
        "embeddium"
      ],
      "keep": "sodium",
      "reason": "Sodium is native on 1.21.1 NeoForge; Embeddium is the legacy Forge fork and conflicts with Veil and Iris."
    },
    {
      "label": "Connected textures",
      "members": [
        "fusion-connected-textures",
        "continuity"
      ],
      "keep": "fusion-connected-textures",
      "reason": "Fusion is NeoForge-native; Continuity is Fabric-only and breaks Sodium item rendering through Connector."
    },
    {
      "label": "Runtime chunk loading",
      "members": [
        "create-power-loader",
        "chunk-loaders"
      ],
      "keep": "create-power-loader",
      "reason": "Both force-load chunks. Power Loader is Create-native and costs rotational power."
    }
  ],
  "removed": [
    {
      "name": "Chipped",
      "slug": "chipped",
      "reason": "Overlaps Rechiseled (both add block variants). Kept Rechiseled because the pack also ships Rechiseled: Create, which bridges it to Create's palettes — Chipped has more raw downloads but no Create integration."
    },
    {
      "name": "Dynamic Lights",
      "slug": "dynamic-lights",
      "reason": "Swapped for LambDynamicLights (51M downloads, in 6/34 reference packs, native NeoForge 1.21.1). Same feature, far better maintained — this was a 1.20.1-era mapping choice."
    },
    {
      "name": "Corail Tombstone",
      "slug": "corail-tombstone",
      "reason": "Swapped for Corpse (8/34 reference packs). Tombstone is a large magic-flavoured death system; Corpse just leaves a body holding your items, which fits a Create pack better."
    },
    {
      "name": "create-big-cannons",
      "slug": "create-big-cannons",
      "reason": "Cannons/artillery — not wanted."
    },
    {
      "name": "create-aeronautics",
      "slug": "create-aeronautics",
      "reason": "Flying contraptions — not wanted."
    },
    {
      "name": "hypertube",
      "slug": "hypertube",
      "reason": "Hypertube transport — not wanted."
    },
    {
      "name": "create-teleporters",
      "slug": "create-teleporters",
      "reason": "Teleportation — not wanted, and it undercuts the rail investment the same way Waystones did."
    },
    {
      "name": "create-propulsion-simulated",
      "slug": "create-propulsion-simulated",
      "reason": "Propellers/thrusters for contraptions — same flying-contraption family as Aeronautics."
    },
    {
      "name": "Create Utilities",
      "slug": "create-utilities",
      "reason": "Re-checked on request: still has no NeoForge 1.21.1 build. Its newest builds stop at 1.20.1."
    },
    {
      "name": "Create: Radars",
      "slug": "create-radars",
      "reason": "Hard-requires createbigcannons >=5.11.2, which was dropped on request. Radars is a targeting addon for the cannons, so it goes with them."
    },
    {
      "name": "Create: Addon Compatibility",
      "slug": "createaddoncompatibility",
      "reason": "Ships 8 data/tfmg/ recipes that fail to parse because TFMG is excluded as an electricity mod (8 RecipeManager errors every startup). Its only other content is 3 Copycats item tags that nothing in this pack consumes. Its purpose is bridging addons we deliberately do not have, so it is net negative."
    },
    {
      "name": "Chunk Loaders",
      "slug": "chunk-loaders",
      "reason": "Redundant with Create: Power Loader, which does the same job Create-natively (loaders driven by rotational power) and has higher adoption. Same reasoning as keeping Rechiseled over Chipped: in a Create pack, the mod that plugs into Create's progression wins. Chunky stays — it pre-generates terrain, which is a different job from runtime chunk loading."
    },
    {
      "name": "Create: Sophisticated Backpacks",
      "slug": "create-sophisticated-backpacks",
      "reason": "No NeoForge 1.21.1 build — the Create/Sophisticated Backpacks bridge stops earlier."
    },
    {
      "name": "Shulker Box Slot",
      "slug": "shulker-box-slot",
      "reason": "Redundant — the pack already has Sophisticated Backpacks and Sophisticated Storage for portable storage."
    },
    {
      "name": "Remove Reloading Screen",
      "slug": "rrls",
      "reason": "Dropped at user request."
    },
    {
      "name": "AutoModpack",
      "slug": "automodpack",
      "reason": "Not needed: every mod now ships via CDN in the manifest (Modrinth + GitHub releases), so there is no private delta for it to sync. Removing it also drops the certificate and download prompts players hit on first join."
    },
    {
      "name": "Create: Dynamic Lights / Sodium Extras",
      "slug": "create-dynamic-lights",
      "reason": "Their Sodium Options API dependency conflicts with the pack's Reese's Sodium Options (client crash) and forced Sodium server-side (server crash). Dropped to keep the established config UI."
    },
    {
      "name": "Zume",
      "slug": "zume",
      "reason": "Third zoom mod in the pack (with Just Zoom 12/100 and Chloride's zoom) all bound to Z. Kept Just Zoom -- higher adoption and a dedicated zoom rather than a Sodium extension feature."
    },
    {
      "name": "TrashSlot",
      "slug": "trashslot",
      "reason": "Adds a trash slot that overlaps other inventory GUI elements and binds T, stealing the chat key. EMI (28/100) already provides item deletion, so it is redundant as well as conflicting."
    },
    {
      "name": "Advancement Plaques",
      "slug": "advancement-plaques",
      "reason": "The pack's guided progression moved from a custom advancement datapack to Questlog, which fires its own toasts. Plaques now only announces OTHER mods' advancements, giving two competing notification channels on screen at once. Better Advancements still provides the readable advancement screen those mods need."
    },
    {
      "name": "InvMove",
      "slug": "invmove",
      "reason": "Let players walk around with the inventory and other GUIs open. Removed on request to restore vanilla behaviour, where opening a container roots you in place."
    },
    {
      "name": "Questlog",
      "slug": "questlog",
      "reason": "Replaced by Boundless: Quests. Questlog has no submission objectives (its registry is detection-only) and no JEI integration, both of which were wanted. Boundless has submit targets that consume handed-in items, a JEI plugin, an in-game editor with export, and the same shippable-JSON plus /reload story."
    }
  ],
  "banned": [
    {
      "slug": "radium",
      "reason": "Create declares a hard incompatibility with Radium on 1.21.1 ('Mod create is incompatible with radium any'). Declared in mods.toml, not Modrinth metadata, so only a boot catches it."
    },
    {
      "slug": "create-tfmg",
      "reason": "Heavy industry addon with an electricity layer — excluded with the other electricity mods."
    },
    {
      "slug": "power-grid",
      "reason": "Electricity distribution for Create — excluded."
    },
    {
      "slug": "createnuclear",
      "reason": "Nuclear power generation (energy/electricity) — excluded."
    },
    {
      "slug": "create-ultimine",
      "reason": "Bridge mod requiring FTB Ultimine (ftbultimine >=2101.1.14), which the pack does not ship — VeinMiner already covers vein mining. The FTB dependency is not declared on Modrinth, so only a boot catches it."
    },
    {
      "slug": "embeddium",
      "reason": "Legacy Forge rendering fork. On 1.21.1 NeoForge both Sodium and Iris ship native builds, and Veil requires Sodium >=0.8.12 explicitly ('Veil supports Sodium 0.8.12-alpha.2+mc1.21.1 and above'). Embeddium conflicts with both Veil and Iris. Replaced by Sodium + Iris."
    },
    {
      "slug": "continuity",
      "reason": "Fabric-only; runs via Sinytra Connector on NeoForge and crashes on EVERY item render. EmissiveItemQuadTransform.transform throws NPE (SpriteFinder.find null) inside Sodium's FRAPI item path — caught rendering Create's menu button icon. Redundant anyway: Fusion provides connected textures natively on NeoForge with 39 builds. Found by jointest.js screenshot, not by any log check."
    },
    {
      "name": "Hopper Gadgetry",
      "slug": "hopper-gadgetry",
      "reason": "Crashes the client on load: 'Missing layer definitions: [hoppergadgetry:grated_hopper_minecart#main, hoppergadgetry:chute_minecart#main]'. It registers minecart entities without registering their client render layers, so any client rendering an overlay dies. Broken regardless of load order."
    },
    {
      "name": "What Are They Up To (Watut)",
      "slug": "what-are-they-up-to",
      "reason": "Client crash on shader reload: ChainedJsonException 'Invalid shaders/core/particle.json: File not found'. Its newest build targets 1.21.0 and references a shader removed in 1.21.1, breaking any 1.21.1 client."
    },
    {
      "name": "Krypton (FNP)",
      "slug": "krypton-fnp",
      "reason": "Incompatible with e4mc: both mixin ServerLoginPacketListenerImpl for network encryption. krypton_fnp replaces the class, so e4mc's getCipher redirector scans 0 targets and dies with a critical injection failure at client load. e4mc is established in the pack; this was an optional perf add."
    },
    {
      "name": "Structory: Towers",
      "slug": "structory-towers",
      "reason": "Ships as a datapack-style jar with no mod entrypoint: NeoForge rejects it with InvalidModFileException 'Missing ModLoader in file (Structory_Towers_26.2_v1.0.17.jar)' and the server refuses to boot. Base Structory is a real mod and stays."
    },
    {
      "name": "Sodium Leaf Culling",
      "slug": "sodiumleafculling",
      "reason": "Client crash: MixinPreProcessorException attaching mixins.sodiumleafculling.json:BlockRenderer -> ClassNotFoundException net.caffeinemc.mods.sodium.client.gui.SodiumGameOptions. It targets a Sodium internal that our Sodium build does not expose."
    }
  ],
  "allowAlpha": [
    "c2me-neoforge",
    "incendium",
    "asyncparticles"
  ],
  "//envOverrides": "Modrinth side-ness that is wrong in practice. BaguetteLib is flagged client_side=unsupported, so it shipped server-only -- but it registers the baguettelib:example payload as required on both sides, and every client was rejected at login with 'channel missing on the client side'. Caught by jointest.",
  "envOverrides": {
    "baguettelib": {
      "client": "required",
      "server": "required"
    },
    "controlify": {
      "client": "required",
      "server": "unsupported"
    },
    "sodium": {
      "client": "required",
      "server": "unsupported"
    },
    "boundless-quests": {
      "client": "required",
      "server": "required"
    }
  },
